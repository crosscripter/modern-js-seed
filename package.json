{
  "name": "modern-js-seed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A modern Node.js and TypeScript project seed with ESLint, Prettier, Vitest, coverage, VS Code configuration, and GitHub Actions CI.",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=12 <13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
